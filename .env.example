# Copy to .env and fill in. Never commit .env. All values are validated at API startup (apps/api/src/env.ts).

NODE_ENV=development
PORT=3000

# Claude Agent SDK. The model is ALWAYS chosen here — no model id is hard-coded anywhere in the source.
ANTHROPIC_API_KEY=replace-with-a-valid-key
CLAUDE_MODEL=replace-with-an-enabled-claude-model
# claude (default) | deterministic — deterministic runs the governed tool sequence without a model; evidence resolution then fails closed.
AGENT_RUNTIME=claude

# PostgreSQL (docker compose up -d postgres)
DATABASE_URL=postgres://sbo:sbo@localhost:5432/sbo

# Public origin of the web app (used for CORS and evidence-upload links in chat)
APP_BASE_URL=http://localhost:5173

# At least 32 random characters (cookie signing). Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Original uploaded evidence is stored here, outside any web root, under generated names
UPLOAD_DIR=./uploads

# Only when the API sits behind a reverse proxy: comma-separated proxy addresses / CIDRs whose X-Forwarded-For is trusted
# (rate limits then key on the real client). Leave empty otherwise — the header is then ignored and cannot be spoofed.
TRUST_PROXY=
