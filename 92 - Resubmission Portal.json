    {
      "parameters": {
        "jsCode": "const input =\n  $('Open Resubmission').first().json;\n\nconst decision =\n  $('Get Original Decision').first().json || {};\n\nconst found =\n  Boolean(decision.case_run_id);\n\nconst outcome =\n  String(decision.outcome || '').toUpperCase();\n\nconst eligible =\n  found &&\n  outcome === 'NEED_MORE_INFORMATION';\n\nreturn [\n  {\n    json: {\n      original_case_run_id:\n        input.original_case_run_id,\n\n      revised_case_run_id:\n        input.revised_case_run_id,\n\n      resubmission_comments:\n        input.resubmission_comments,\n\n      original_decision_found:\n        found,\n\n      original_outcome:\n        outcome,\n\n      resubmission_eligible:\n        eligible,\n    },\n  },\n];"
      },
