    {
      "parameters": {
        "jsCode": "const original =\n  $('Get Original Case').first().json;\n\nconst revised =\n  $('Get Revised Case').first().json;\n\nconst sameLogicalCase =\n  original.Case_ID === revised.Case_ID;\n\nconst originalVersion =\n  Number(original.Submission_Version);\n\nconst revisedVersion =\n  Number(revised.Submission_Version);\n\nconst versionIncreased =\n  revisedVersion > originalVersion;\n\nconst differentRun =\n  original.Case_Run_ID !== revised.Case_Run_ID;\n\nconst valid =\n  sameLogicalCase &&\n  versionIncreased &&\n  differentRun;\n\nreturn [\n  {\n    json: {\n      original_case_run_id:\n        original.Case_Run_ID,\n\n      revised_case_run_id:\n        revised.Case_Run_ID,\n\n      logical_case_id:\n        original.Case_ID,\n\n      original_version:\n        originalVersion,\n\n      revised_version:\n        revisedVersion,\n\n      same_logical_case:\n        sameLogicalCase,\n\n      version_increased:\n        versionIncreased,\n\n      relationship_valid:\n        valid,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
