    {
      "parameters": {
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "=<h2>Evidence uploaded</h2>\n\n<p><strong>Case:</strong>\n{{$('Prepare Uploaded Evidence').first().json.case_run_id}}</p>\n\n<p><strong>Evidence request:</strong>\n{{$('Prepare Uploaded Evidence').first().json.evidence_request_id}}</p>\n\n<p><strong>File:</strong>\n{{$('Prepare Uploaded Evidence').first().json.file_name || 'Uploaded PDF'}}</p>\n\n<p>Your synthetic evidence has been received.</p>\n\n<p>Return to the Agent chat and type <strong>UPLOADED</strong>\nso the assessment can continue.</p>\n\n<hr>\n\n<p><em>No production-system update has been performed.</em></p>"
      },
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        2688,
        -192
      ],
      "id": "5189cb7e-d653-45d5-a3b9-522eb00568db",
      "name": "Show Upload Completed",
      "webhookId": "5e349bed-cd90-48b4-b697-b035f7d894c7"
    },
    {
      "parameters": {
        "jsCode": "/*\n============================================================\nNORMALISE EVIDENCE UPLOAD INPUT\n============================================================\n\nReads IDs defensively from possible Form Trigger payload shapes.\n\nAlso preserves the uploaded binary PDF.\n============================================================\n*/\n\nconst item =\n  $input.first() || {};\n\nconst input =\n  item.json || {};\n\nconst body =\n  input.body &&\n  typeof input.body === 'object'\n    ? input.body\n    : {};\n\nconst query =\n  input.query &&\n  typeof input.query === 'object'\n    ? input.query\n    : {};\n\nconst formData =\n  input.formData &&\n  typeof input.formData === 'object'\n    ? input.formData\n    : {};\n\nconst data =\n  input.data &&\n  typeof input.data === 'object'\n    ? input.data\n    : {};\n\nfunction firstNonEmpty(...values) {\n  for (const value of values) {\n    if (\n      value !== undefined &&\n      value !== null &&\n      String(value).trim() !== ''\n    ) {\n      return String(value).trim();\n    }\n  }\n\n  return '';\n}\n\nconst evidenceRequestId =\n  firstNonEmpty(\n    input.evidence_request_id,\n    body.evidence_request_id,\n    query.evidence_request_id,\n    formData.evidence_request_id,\n    data.evidence_request_id\n  );\n\nconst caseRunId =\n  firstNonEmpty(\n    input.case_run_id,\n    body.case_run_id,\n    query.case_run_id,\n    formData.case_run_id,\n    data.case_run_id\n  );\n\nreturn [\n  {\n    json: {\n      ...input,\n\n      evidence_request_id:\n        evidenceRequestId,\n\n      /*\n      This remains the customer/form-supplied value.\n      The authoritative value will be retrieved from\n      dt_evidence_requests later.\n      */\n      supplied_case_run_id:\n        caseRunId,\n\n      case_run_id:\n        caseRunId,\n\n      upload_input_received_at:\n        new Date().toISOString(),\n    },\n\n    /*\n    Preserve the uploaded file.\n    */\n    binary:\n      item.binary || {},\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
