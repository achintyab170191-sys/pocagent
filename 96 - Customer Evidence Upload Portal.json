      "id": "f5a98d23-47bb-41dc-ae78-6578968e5fd5",
      "name": "Get Evidence Request",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "/*\n============================================================\nVALIDATE EVIDENCE REQUEST\n============================================================\n\nThe evidence-request table row is the authoritative source\nfor case_run_id.\n\nRules:\n- Evidence request must exist.\n- Status must permit evidence submission.\n- If the form supplied a case ID, it must match.\n- If the form omitted case ID, use the stored case ID.\n============================================================\n*/\n\nconst submitted =\n  $('Normalise Evidence Upload Input')\n    .first()\n    .json || {};\n\nconst requestRows =\n  $input\n    .all()\n    .map(item =>\n      item.json || {}\n    )\n    .filter(row =>\n      String(\n        row.evidence_request_id || ''\n      ).trim()\n    );\n\nconst request =\n  requestRows[0] || {};\n\nconst submittedEvidenceRequestId =\n  String(\n    submitted.evidence_request_id || ''\n  ).trim();\n\nconst storedEvidenceRequestId =\n  String(\n    request.evidence_request_id || ''\n  ).trim();\n\nconst suppliedCaseRunId =\n  String(\n    submitted.supplied_case_run_id ||\n    submitted.case_run_id ||\n    ''\n  ).trim();\n\nconst storedCaseRunId =\n  String(\n    request.case_run_id || ''\n  ).trim();\n\nconst currentStatus =\n  String(\n    request.status || ''\n  )\n    .trim()\n    .toUpperCase();\n\nconst permittedStatuses = [\n  'OPEN',\n  'PARTIALLY_RECEIVED',\n  'INSUFFICIENT',\n];\n\nconst requestFound =\n  Boolean(\n    storedEvidenceRequestId\n  );\n\nconst requestIdMatches =\n  requestFound &&\n  storedEvidenceRequestId ===\n    submittedEvidenceRequestId;\n\n/*\nA missing supplied case ID is acceptable because the request\nrecord already owns the authoritative case ID.\n\nA supplied but different case ID is not acceptable.\n*/\nconst caseMismatch =\n  Boolean(\n    suppliedCaseRunId &&\n    storedCaseRunId &&\n    suppliedCaseRunId !==\n      storedCaseRunId\n  );\n\nconst statusPermitted =\n  permittedStatuses.includes(\n    currentStatus\n  );\n\nconst effectiveCaseRunId =\n  storedCaseRunId ||\n  suppliedCaseRunId;\n\nconst uploadAllowed =\n  requestFound &&\n  requestIdMatches &&\n  Boolean(\n    effectiveCaseRunId\n  ) &&\n  !caseMismatch &&\n  statusPermitted;\n\nlet rejectionReason = '';\n\nif (!submittedEvidenceRequestId) {\n  rejectionReason =\n    'EVIDENCE_REQUEST_ID_NOT_SUPPLIED';\n} else if (!requestFound) {\n  rejectionReason =\n    'EVIDENCE_REQUEST_NOT_FOUND';\n} else if (!requestIdMatches) {\n  rejectionReason =\n    'EVIDENCE_REQUEST_ID_MISMATCH';\n} else if (!effectiveCaseRunId) {\n  rejectionReason =\n    'CASE_RUN_ID_NOT_AVAILABLE';\n} else if (caseMismatch) {\n  rejectionReason =\n    'CASE_RUN_ID_MISMATCH';\n} else if (!statusPermitted) {\n  rejectionReason =\n    'EVIDENCE_REQUEST_NOT_OPEN';\n}\n\nreturn [\n  {\n    json: {\n      evidence_request_id:\n        storedEvidenceRequestId ||\n        submittedEvidenceRequestId,\n\n      /*\n      Authoritative effective value used downstream.\n      */\n      case_run_id:\n        effectiveCaseRunId,\n\n      supplied_case_run_id:\n        suppliedCaseRunId,\n\n      stored_case_run_id:\n        storedCaseRunId,\n\n      current_status:\n        currentStatus,\n\n      request_found:\n        requestFound,\n\n      request_id_matches:\n        requestIdMatches,\n\n      case_mismatch:\n        caseMismatch,\n\n      status_permitted:\n        statusPermitted,\n\n      upload_allowed:\n        uploadAllowed,\n\n      rejection_reason:\n        rejectionReason,\n\n      submission_version:\n        Number(\n          request.submission_version || 1\n        ),\n\n      originating_check_type:\n        String(\n          request.originating_check_type ||\n          ''\n        ).trim(),\n\n      evidence_channel:\n        String(\n          request.evidence_channel ||\n          ''\n        ).trim(),\n\n      evidence_acceptance_policy:\n        String(\n          request.evidence_acceptance_policy ||\n          ''\n        ).trim(),\n\n      request_row:\n        request,\n    },\n\n    /*\n    Preserve the uploaded file through validation.\n    */\n    binary:\n      $('Normalise Evidence Upload Input')\n        .first()\n        .binary || {},\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "d56bd070-9892-4aef-9fcd-9332d2140b61",
      "name": "Validate Evidence Request"
    },
    {
      "parameters": {
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "=<h2>Upload cannot be accepted</h2>\n\n<p>\nThe evidence request could not be validated for this upload.\n</p>\n\n<p>\n<strong>Evidence Request ID:</strong>\n{{$json.evidence_request_id || 'Not supplied'}}\n</p>\n\n<p>\n<strong>Supplied Case Run ID:</strong>\n{{$json.supplied_case_run_id || 'Not supplied'}}\n</p>\n\n<p>\n<strong>Stored Case Run ID:</strong>\n{{$json.stored_case_run_id || 'Not found'}}\n</p>\n\n<p>\n<strong>Current Status:</strong>\n{{$json.current_status || 'Not found'}}\n</p>\n\n<p>\n<strong>Validation reason:</strong>\n{{$json.rejection_reason || 'Unknown'}}\n</p>\n\n<hr>\n\n<p>\n<em>No case or evidence record was changed.</em>\n</p>"
      },
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        1120,
        96
      ],
      "id": "a75135bf-4e31-4eba-9e27-843241d2e948",
      "name": "Show Upload Not Allowed",
      "webhookId": "561d110f-9f3c-43a6-98cd-60bebba5e78e"
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "evidence_file",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1120,
        -96
      ],
      "id": "b7b5295e-4823-4b36-8d1f-65ada1c07933",
      "name": "Extract PDF Text"
    },
    {
      "parameters": {
        "jsCode": "const extracted =\n  $json || {};\n\nconst candidates = [\n  extracted.text,\n  extracted.content,\n  extracted.data,\n  extracted.document?.text,\n  extracted.pages,\n];\n\nlet text = '';\n\nfor (const candidate of candidates) {\n  if (\n    candidate !== undefined &&\n    candidate !== null\n  ) {\n    if (typeof candidate === 'string') {\n      text = candidate.trim();\n      break;\n    }\n\n    if (Array.isArray(candidate)) {\n      text = candidate\n        .map(item =>\n          typeof item === 'string'\n            ? item\n            : (\n                item.text ??\n                item.content ??\n                JSON.stringify(item)\n              )\n        )\n        .join('\\n')\n        .trim();\n\n      if (text) {\n        break;\n      }\n    }\n  }\n}\n\nreturn [\n  {\n    json: {\n      extracted_text:\n        text,\n\n      text_available:\n        text.length >= 20,\n\n      extracted_character_count:\n        text.length,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -96
      ],
      "id": "84aeac7d-89ed-481f-acfe-6cc86458c67f",
      "name": "Check Extracted PDF"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "f8fe0a66-3202-4a0d-9307-daf0d92ec6db",
              "leftValue": "={{$json.text_available}}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1568,
