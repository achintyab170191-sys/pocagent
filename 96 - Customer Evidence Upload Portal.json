      "id": "1b4e53ab-d6f5-4141-a98a-2aee503e4762",
      "name": "PDF Text Available?"
    },
    {
      "parameters": {
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "<h2>The uploaded PDF could not be read</h2>\n\n<p>The PDF did not contain enough extractable text for the prototype\nto assess it.</p>\n\n<p>Please upload a clear, text-based PDF and try again.</p>\n\n<p><em>The evidence request remains open.</em></p>"
      },
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        1792,
        0
      ],
      "id": "6a950808-11fc-4771-b1f3-39fa2a0a2939",
      "name": "Show Unreadable PDF",
      "webhookId": "b5857807-b449-4b77-b389-6800b2f8ae43"
    },
    {
      "parameters": {
        "jsCode": "const form =\n  $('Validate Evidence Request')\n    .first()\n    .json;\n\nconst request =\n  $('Get Evidence Request')\n    .first()\n    .json;\n\nconst extracted =\n  $('Check Extracted PDF')\n    .first()\n    .json;\n\nconst binary =\n  $('Validate Evidence Request')\n    .first()\n    .binary || {};\n\nconst uploadedFile =\n  binary.evidence_file ||\n  Object.values(binary)[0] ||\n  {};\n\nreturn [\n  {\n    json: {\n      evidence_id:\n        `EVIDENCE-${request.case_run_id}-${Date.now()}`,\n\n      evidence_request_id:\n        request.evidence_request_id,\n\n      case_run_id:\n        request.case_run_id,\n\n      submission_version:\n        Number(\n          request.submission_version || 1\n        ),\n\n      evidence_type:\n        form.evidence_type ||\n        'OTHER',\n\n      evidence_source:\n        'FILE_UPLOAD',\n\n      file_name:\n        uploadedFile.fileName || '',\n\n      mime_type:\n        uploadedFile.mimeType ||\n        'application/pdf',\n\n      storage_url:\n        '',\n\n      evidence_text:\n        extracted.extracted_text,\n\n      structured_data_json:\n        JSON.stringify({\n          evidence_notes:\n            form.evidence_notes || '',\n\n          extracted_character_count:\n            extracted\n              .extracted_character_count,\n        }),\n\n      validation_status:\n        'RECEIVED',\n\n      confidence:\n        0,\n\n      provided_at:\n        new Date().toISOString(),\n\n      superseded:\n        false,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
