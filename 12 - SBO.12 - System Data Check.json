    {
      "parameters": {
        "jsCode": "const row =\n  $('Get Mock Utility Result').first().json;\n\nconst rules = $('Get Decision Rules')\n  .all()\n  .map(item => item.json);\n\nfunction splitSemi(value) {\n  if (!value) {\n    return [];\n  }\n\n  return String(value)\n    .split(';')\n    .map(value => value.trim())\n    .filter(Boolean);\n}\n\nfunction safeParse(value) {\n  try {\n    return value ? JSON.parse(value) : {};\n  } catch (error) {\n    return {\n      parse_error: true,\n      raw_value: value,\n    };\n  }\n}\n\nfunction toBoolean(value) {\n  return value === true ||\n    String(value).toLowerCase() === 'true';\n}\n\nconst ruleIds = splitSemi(row.Rule_IDs);\n\nconst applicableRules = rules\n  .filter(rule => ruleIds.includes(rule.Rule_ID))\n  .sort(\n    (a, b) =>\n      Number(a.Priority ?? 9999) -\n      Number(b.Priority ?? 9999)\n  );\n\nconst hasTbd = applicableRules.some(\n  rule =>\n    String(rule.Rule_Status).toUpperCase() ===\n    'TBD'\n);\n\nlet appliedRule = null;\n\nif (hasTbd) {\n  appliedRule = rules.find(\n    rule => rule.Rule_ID === 'CTRL-001'\n  );\n} else {\n  appliedRule =\n    applicableRules.find(rule =>\n      [\n        'REJECT',\n        'NEED_MORE_INFORMATION',\n        'MANUAL_REVIEW',\n      ].includes(\n        String(rule.Final_Outcome).toUpperCase()\n      )\n    ) ||\n    applicableRules[0] ||\n    null;\n}\n\nconst terminalOutcome =\n  appliedRule?.Final_Outcome || 'CONTINUE';\n\nreturn [\n  {\n    json: {\n      case_run_id: row.Case_Run_ID,\n      submission_version: 1,\n      sequence: Number(row.Sequence),\n      agent_id: row.Agent_ID,\n      utility_name: row.Utility_Name,\n      check_type: row.Check_Type,\n      status: row.Status,\n      findings: safeParse(row.Findings_JSON),\n      reason_codes: splitSemi(row.Reason_Codes),\n      evidence_references: splitSemi(\n        row.Evidence_References\n      ),\n      confidence: Number(row.Confidence || 0),\n      human_review_required: toBoolean(\n        row.Human_Review_Required\n      ),\n      recommended_next_step:\n        row.Recommended_Next_Step,\n      rule_ids: ruleIds,\n      rule_status_used: row.Rule_Status_Used,\n      applied_rule: appliedRule,\n      is_terminal: [\n        'REJECT',\n        'NEED_MORE_INFORMATION',\n        'MANUAL_REVIEW',\n      ].includes(\n        String(terminalOutcome).toUpperCase()\n      ),\n      terminal_outcome: terminalOutcome,\n      prototype_data: true,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
