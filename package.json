{
  "name": "sbo-agentic-parity-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:api dev:web",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "npm --workspace @sbo/web run dev",
    "build": "npm run typecheck && node scripts/build-api.mjs && npm --workspace @sbo/web run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "import:sources": "tsx scripts/import-sources.ts",
    "reset:runtime": "tsx scripts/reset-runtime.ts",
    "report:parity": "tsx scripts/parity-report.ts",
    "docs:traceability": "tsx scripts/build-traceability.ts",
    "analyse:sources": "node scripts/analyse-source.mjs",
    "extract:prompts": "node scripts/extract-prompts.mjs",
    "verify:sources": "tsx scripts/verify-sources.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.31",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "fastify": "^5.2.1",
    "mammoth": "^1.13.0",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.15.0",
    "jszip": "^3.10.2",
    "npm-run-all": "^4.1.5",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.51.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  }
}
